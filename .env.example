# Copia este archivo como .env en la raíz del proyecto y ajusta los valores.
# .env no se sube al repositorio. Las variables ya definidas en el sistema tienen prioridad.
# Todos los valores de este ejemplo son ficticios.

# --- Modo ---------------------------------------------------------------------
# 1 = demostración local: SQLite (demo.sqlite3), DEBUG activo, clave de desarrollo y datos ficticios.
# Déjala sin definir en el servidor: sin ella la aplicación arranca en modo producción.
# CICC_DEMO=1

# Solo DEBUG=1 lo activa. En producción debe quedar en 0 o sin definir.
DEBUG=0

# --- Seguridad ----------------------------------------------------------------
# Obligatoria en producción. Queda vacía a propósito: la aplicación no arranca hasta que pongas
# una clave propia. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Obligatoria en producción: nombres o direcciones con los que se accede al servidor, separados por comas.
CICC_ALLOWED_HOSTS=cicc.ejemplo.local,localhost

# Solo si hay un proxy inverso: orígenes completos de confianza para CSRF, separados por comas.
# CICC_CSRF_TRUSTED_ORIGINS=https://cicc.ejemplo.local

# 1 si la aplicación se sirve por HTTPS: cookies seguras, redirección a HTTPS y HSTS.
# El proxy inverso debe enviar la cabecera X-Forwarded-Proto.
# CICC_HTTPS=1

# --- Contenido protegido ------------------------------------------------------
# Clave Fernet que cifra las credenciales y las imágenes del contenido importado
# (docs/IMPORTAR-DOCUMENTACION.md). Genérala con «python manage.py generate_data_key».
# Si se pierde, ese contenido no se puede leer: guárdala aparte del respaldo de la base.
# CICC_DATA_KEY=

# --- Base de datos PostgreSQL (obligatorias en producción) ----------------------
PGDATABASE=cicc
PGUSER=cicc_app
PGPASSWORD=contraseña-ficticia
PGHOST=localhost
# Opcional, por defecto 5432.
PGPORT=5432

# Alias histórico: 1 fuerza SQLite en cualquier modo, sin relajar las demás reglas.
# QA_SQLITE=1

# --- Solo para pruebas ----------------------------------------------------------
# Otra ruta de archivo .env, o vacía para no leer ninguno.
# CICC_ENV_FILE=
